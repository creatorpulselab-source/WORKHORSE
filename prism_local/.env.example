# Prism Environment Variables
# Copy this to .env for local dev, or set these as Fly.io secrets (fly secrets set KEY=value)

# --- Required: at least one AI provider ---
GEMINI_API_KEY=your_gemini_api_key_here        # get free at aistudio.google.com/apikey
OPENAI_API_KEY=your_openai_api_key_here        # optional: platform.openai.com/api-keys
GROK_API_KEY=your_grok_api_key_here            # optional: console.x.ai

# --- Admin account (set before first deploy) ---
ADMIN_PASSWORD=choose_a_strong_password        # if not set, a random password is generated and printed in logs

# --- Optional: Vertex AI (mask-guided inpainting / Imagen edit_image) ---
# GOOGLE_APPLICATION_CREDENTIALS=prism-vertex-key.json   # service account key, keep out of git
# GCP_PROJECT=gen-lang-client-0127104177
# GCP_LOCATION=us-central1

# --- Optional overrides ---
# AI_PROVIDER=gemini                           # auto-detected from which key is set
# VISION_MODEL=gemini-2.0-flash               # default: reads from config.json
# OLLAMA_HOST=http://localhost:11434           # only needed for local Ollama mode
# PORT=7861                                   # Fly.io sets this automatically (internal_port in fly.toml)
